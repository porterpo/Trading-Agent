# Broker / exchange
#   paper  → in-memory simulator (default; boots without credentials)
#   mt5    → MetaTrader5 bridge (HFM, EasyMarkets, IC Markets, any MT5 broker).
#            Requires Windows + the broker's MT5 terminal installed & logged in.
#   <ccxt> → any ccxt exchange id (binance, bybit, kraken, ...)
EXCHANGE_ID=paper

# Shared across backends
# MT5: EXCHANGE_ACCOUNT_ID = numeric login, EXCHANGE_API_KEY = your MT5 password
# If your password starts with # or contains spaces, wrap it in double quotes.
EXCHANGE_ACCOUNT_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true
DEFAULT_LEVERAGE=30

# MT5-only settings
# MT5_SERVER: exact server name from the MT5 login dialog, e.g. HFMarketsGlobal-Demo
# MT5_TERMINAL_PATH: absolute path to terminal64.exe (leave blank to auto-detect)
# MT5_SYMBOL_SUFFIX: broker-specific suffix (e.g. .a or m); leave blank if none
# MT5_MAGIC: magic number tagged on every order this agent places
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_SYMBOL_SUFFIX=
MT5_MAGIC=20260911

# TradingView webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Persistence
DB_PATH=trading_agent.db

# ForexFactory tier-1 calendar
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Optional indicator control endpoint (toggles useStrictPeaks)
INDICATOR_CONTROL_URL=
