# Broker / exchange
#   paper  → in-memory simulator (default; boots without credentials)
#   oanda  → placeholder for a native OANDA v20 REST integration (paper fallback)
#   mt5    → placeholder for a MetaTrader5 Python-bridge integration (paper fallback)
#   <ccxt> → any ccxt exchange id (binance, bybit, kraken, ...)
EXCHANGE_ID=paper
EXCHANGE_ACCOUNT_ID=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_SANDBOX=true
DEFAULT_LEVERAGE=30

# TradingView webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Persistence
DB_PATH=trading_agent.db

# ForexFactory tier-1 calendar
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# Optional indicator control endpoint (toggles useStrictPeaks)
INDICATOR_CONTROL_URL=
